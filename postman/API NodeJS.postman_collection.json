{
  "info": {
    "name": "API NodeJS - Projeto P1",
    "description": "Testes dos CRUDs e da paginação do projeto.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Status HTTP esperado\", function () {",
          "    const name = pm.info.requestName;",
          "    const invalidNames = [\"VALIDAÇÃO OBRIGATÓRIO\", \"VALIDAÇÃO MÍNIMO\", \"VALIDAÇÃO NOME\", \"VALIDAÇÃO EMAIL\", \"CREATE DUPLICADO\", \"EDIT DUPLICADO\"];",
          "    const expected = invalidNames.includes(name) ? 400 : name === \"NOT FOUND\" ? 404 : name === \"CREATE\" ? 201 : 200;",
          "    pm.expect(pm.response.code).to.equal(expected);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Situations",
      "item": [
        { "name": "CREATE", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "    pm.environment.set(\"situationId\", pm.response.json().situation.id);", "}"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nameSituation\": \"Em análise\"\n}" }, "url": "{{baseUrl}}/situations" } },
        { "name": "VALIDAÇÃO OBRIGATÓRIO", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Nome obrigatório retorna 400\", () => pm.response.to.have.status(400));"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nameSituation\": \"\"\n}" }, "url": "{{baseUrl}}/situations" } },
        { "name": "VALIDAÇÃO MÍNIMO", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Nome curto retorna 400\", () => pm.response.to.have.status(400));"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nameSituation\": \"At\"\n}" }, "url": "{{baseUrl}}/situations" } },
        { "name": "CREATE DUPLICADO", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Nome duplicado retorna 400\", () => pm.response.to.have.status(400));"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nameSituation\": \"Ativo\"\n}" }, "url": "{{baseUrl}}/situations" } },
        { "name": "LIST", "request": { "method": "GET", "url": "{{baseUrl}}/situations?page=1&limit=10" } },
        { "name": "VIEW", "request": { "method": "GET", "url": "{{baseUrl}}/situations/{{situationId}}" } },
        { "name": "EDIT", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nameSituation\": \"Em análise atualizada\"\n}" }, "url": "{{baseUrl}}/situations/{{situationId}}" } },
        { "name": "EDIT DUPLICADO", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Edição com nome duplicado retorna 400\", () => pm.response.to.have.status(400));"] } }], "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nameSituation\": \"Ativo\"\n}" }, "url": "{{baseUrl}}/situations/{{situationId}}" } },
        { "name": "DELETE", "request": { "method": "DELETE", "url": "{{baseUrl}}/situations/{{situationId}}" } }
      ]
    },
    {
      "name": "Rota Genérica",
      "item": [
        { "name": "Teste API", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Conexão com a API\", () => pm.response.to.have.status(200));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/test-connection" } }
      ]
    },
    {
      "name": "Users",
      "item": [
        { "name": "CREATE", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "    pm.environment.set(\"userId\", pm.response.json().user.id);", "}"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Novo Usuário\",\n  \"email\": \"novo@teste.com\",\n  \"password\": \"123456\",\n  \"situation\": {{userSituationId}}\n}" }, "url": "{{baseUrl}}/users" } },
        { "name": "VALIDAÇÃO OBRIGATÓRIO", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Novo Usuário\",\n  \"email\": \"outro@teste.com\",\n  \"situation\": {{userSituationId}}\n}" }, "url": "{{baseUrl}}/users" } },
        { "name": "VALIDAÇÃO MÍNIMO", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Novo Usuário\",\n  \"email\": \"outro@teste.com\",\n  \"password\": \"12345\",\n  \"situation\": {{userSituationId}}\n}" }, "url": "{{baseUrl}}/users" } },
        { "name": "VALIDAÇÃO NOME", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ab\",\n  \"email\": \"outro@teste.com\",\n  \"password\": \"123456\",\n  \"situation\": {{userSituationId}}\n}" }, "url": "{{baseUrl}}/users" } },
        { "name": "VALIDAÇÃO EMAIL", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Novo Usuário\",\n  \"email\": \"email-invalido\",\n  \"password\": \"123456\",\n  \"situation\": {{userSituationId}}\n}" }, "url": "{{baseUrl}}/users" } },
        { "name": "CREATE DUPLICADO", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Outro Usuário\",\n  \"email\": \"baiao@baiao.com.br\",\n  \"password\": \"123456\",\n  \"situation\": {{userSituationId}}\n}" }, "url": "{{baseUrl}}/users" } },
        { "name": "LIST", "request": { "method": "GET", "url": "{{baseUrl}}/users?page=1&limit=10" } },
        { "name": "VIEW", "request": { "method": "GET", "url": "{{baseUrl}}/users/{{userId}}" } },
        { "name": "EDIT", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Usuário Atualizado\",\n  \"email\": \"atualizado@teste.com\",\n  \"situationId\": {{userSituationId}}\n}" }, "url": "{{baseUrl}}/users/{{userId}}" } },
        { "name": "EDIT DUPLICADO", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Usuário Atualizado\",\n  \"email\": \"baiao@baiao.com.br\",\n  \"situation\": {{userSituationId}}\n}" }, "url": "{{baseUrl}}/users/{{userId}}" } },
        { "name": "DELETE", "request": { "method": "DELETE", "url": "{{baseUrl}}/users/{{userId}}" } },
        { "name": "NOT FOUND", "request": { "method": "GET", "url": "{{baseUrl}}/users/999999" } }
      ]
    },
    {
      "name": "Product Categories",
      "item": [
        { "name": "CREATE", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "    pm.environment.set(\"productCategoryId\", pm.response.json().productCategory.id);", "}"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Acessórios\"\n}" }, "url": "{{baseUrl}}/product-categories" } },
        { "name": "LIST", "request": { "method": "GET", "url": "{{baseUrl}}/product-categories?page=1&limit=10" } },
        { "name": "VIEW", "request": { "method": "GET", "url": "{{baseUrl}}/product-categories/{{productCategoryId}}" } },
        { "name": "EDIT", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Acessórios atualizados\"\n}" }, "url": "{{baseUrl}}/product-categories/{{productCategoryId}}" } },
        { "name": "DELETE", "request": { "method": "DELETE", "url": "{{baseUrl}}/product-categories/{{productCategoryId}}" } }
      ]
    },
    {
      "name": "Product Situations",
      "item": [
        { "name": "CREATE", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "    pm.environment.set(\"productSituationId\", pm.response.json().productSituation.id);", "}"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Em manutenção\"\n}" }, "url": "{{baseUrl}}/product-situations" } },
        { "name": "LIST", "request": { "method": "GET", "url": "{{baseUrl}}/product-situations?page=1&limit=10" } },
        { "name": "VIEW", "request": { "method": "GET", "url": "{{baseUrl}}/product-situations/{{productSituationId}}" } },
        { "name": "EDIT", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Em manutenção atualizada\"\n}" }, "url": "{{baseUrl}}/product-situations/{{productSituationId}}" } },
        { "name": "DELETE", "request": { "method": "DELETE", "url": "{{baseUrl}}/product-situations/{{productSituationId}}" } }
