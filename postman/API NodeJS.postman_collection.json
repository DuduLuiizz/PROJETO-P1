    },
    {
      "name": "Products",
      "item": [
        { "name": "CREATE", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "    pm.environment.set(\"productId\", pm.response.json().product.id);", "}"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Monitor\",\n  \"slug\": \"Monitor\",\n  \"productSituationId\": {{seedProductSituationId}},\n  \"productCategoryId\": {{seedProductCategoryId}}\n}" }, "url": "{{baseUrl}}/products" } },
        { "name": "LIST", "request": { "method": "GET", "url": "{{baseUrl}}/products?page=1&limit=10" } },
        { "name": "VIEW", "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}" } },
        { "name": "EDIT", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Monitor atualizado\",\n  \"productSituationId\": {{seedProductSituationId}},\n  \"productCategoryId\": {{seedProductCategoryId}}\n}" }, "url": "{{baseUrl}}/products/{{productId}}" } },
        { "name": "DELETE", "request": { "method": "DELETE", "url": "{{baseUrl}}/products/{{productId}}" } },
        { "name": "NOT FOUND", "request": { "method": "GET", "url": "{{baseUrl}}/products/999999" } }
      ]
    }
  ]
}
